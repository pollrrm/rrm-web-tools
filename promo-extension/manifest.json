{
  "manifest_version": 3,
  "name": "RRM Promo Helper",
  "version": "0.1.0",
  "description": "Side-panel helper for posting homepage promos on RRM & SCMM. Paste the promo email → parse → get the real WPBakery row (fields + both link encodings + date-based auto show/hide) to copy, or auto-fill it on the homepage. Independent of the RRM Training / Blog / Video helpers.",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://www.ringringmarketing.com/*",
    "https://ringringmarketing.com/*",
    "https://www.seniorcaremarketingmax.com/*",
    "https://seniorcaremarketingmax.com/*"
  ],
  "action": {
    "default_title": "RRM Promo Helper — open side panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ringringmarketing.com/wp-admin/post.php*",
        "https://ringringmarketing.com/wp-admin/post.php*",
        "https://www.seniorcaremarketingmax.com/wp-admin/post.php*",
        "https://seniorcaremarketingmax.com/wp-admin/post.php*"
      ],
      "js": ["content-wp.js"],
      "run_at": "document_idle"
    }
  ]
}
